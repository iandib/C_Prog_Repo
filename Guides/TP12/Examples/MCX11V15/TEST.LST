0001                               *TEST.AS
0002                               *
0003                               *******************************************************************************
0004                               *    MCX ESR equates                                                          *
0005                               *******************************************************************************
0006                               
0007 0001                          .wait.   equ   1                   Wait for an event to occur
0008 0002                          .signal. equ   2                   Signal the occurence of an event
0009 0003                          .pend.   equ   3                   Set a semaphore to PENDing state
0010 0004                          .send.   equ   4                   Send a message to a task
0011 0005                          .sendw.  equ   5                   Send a message and wait for response
0012 0006                          .receive. equ   6                  Receive a message 
0013 0007                          .deque.  equ   7                   Dequeue an entery from a FIFO queue
0014 0008                          .enque.  equ   8                   Enqueue an entry into a FIFO queue
0015 0009                          .resume. equ   9                   Resume a suspended task
0016 000a                          .suspend. equ   10                 Suspend a task
0017 000b                          .terminate. equ   11               Terminate a task
0018 000c                          .execute. equ   12                 Execute a task
0019 000d                          .delay.  equ   13                  Delay a task for a period of time
0020 000e                          .timer.  equ   14                  Set up a timer
0021 000f                          .purge.  equ   15                  Purge active timer(s)
0022                               
0023                               *******************************************************************************
0024                               *    MESSAGE EQUATES                                                          *
0025                               *******************************************************************************
0026                               
0027 0000                          MLINK    equ   0                   Message link pointer
0028 0002                          MTASK    equ   2                   Message's sending task
0029 0003                          MSEMA    equ   3                   Message semaphore
0030 0004                          MBODY    equ   4                   Start of message body
0031                               
0032                               *******************************************************************************
0033                               *    TEST equates                                                             *
0034                               *******************************************************************************
0035                               
0036                               * REMEMBER task 1 is the CLOCK DRIVER *
0037                               
0038 0002                          T2     equ    2
0039 0003                          T3     equ    3
0040 0004                          T4     equ    4
0041 0005                          T5     equ    5
0042                               
0043 0002                          SEMA_a equ    2          Semaphore that T2 waits on
0044 0003                          SEMA_b equ    3          Semaphore that T3 waits on
0045 0004                          SEMA_C equ    4          Semaphore that is reset by T4
0046 0005                          SEMA_D equ    5          Semaphore that is signalled by T4 & waited by T3
0047                               
0048 0001                          TESTQ_1 equ    1         Test queue 1, used by T5 & T2
0049 0002                          TESTQ_2 equ    2         Test queue 2, used by T4 & T3
0050                               
0051 0001                          tstmsg  equ   $0001      Message to be sent to task 4
0052 0008                          savptr  equ   $0008
0053 0010                          qdestn  equ   $0010      Address of dequeued test text string
0054                               
0055 0024                          ENDOFQ  equ   '$         End of queue message is dollar sign ($)
0056                               *******************************************************************************
0057                               
0058 e800                                  ORG $E800
0059                               
0060                               ******************************************************************************
0061                               *  Out of reset task 1 and 2 (and of course the null task) are the only tasks
0062                               *  that are runnable. This is setup in the SYSTEM.AS file on task
0063                               *  initialization. The other 3 tasks are in the idle state.
0064                               ******************************************************************************
0065                               *task 2 todo's: 
0066                               * 1. Delays 5 seconds.                               
0067                               *    During this delay we will spend most of our time in the null task.
0068                               *    Except for when tick timer expires.
0069                               * 2. Make task 3 runnable.
0070                               *    This will not cause a task switch due to task 3 is a lower priority.
0071                               * 3. Waits on named semaphore (SEMA_a). Upon a signal from task 5.  
0072                               * 4. It deques a message sent from task 5. Since task 5 is enqueing to Queue 1
0073                               *    (1 x 8) queue and is a lower priority task, we will bounce back in forth
0074                               *    between task 2 and 5 until complete message is sent. If Queue 1 would have
0075                               *    been configured as a 4 x 2 queue, then task 2 would not have been awaken
0076                               *    on the dequeue ESR until all 4 bytes were enqueued by task 5.
0077                               * 5. Signal named semaphore (SEMA_b).
0078                               * 6. Terminate self.
0079                               *****************************************************************************
0080 e800 4f                 [ 2 ] tsk2    clra
0081 e801 5f                 [ 2 ]         clrb
0082 e802 ce 00 66           [ 3 ]         ldx    #5000/49
0083 e805 3f                 [14 ]         swi
0084 e806 0d                                FCB   .delay.    Delay start of task for 5 seconds. Except for
0085                               *                          the first time through this code, there should now
0086                               *                          be 2 timers in the thread. (see task 5)
0087                                   
0088 e807 86 03              [ 2 ]         ldaa   #T3        set up task 3 for execution
0089 e809 3f                 [14 ]         swi
0090 e80a 0c                                FCB   .execute.
0091                               
0092 e80b c6 02              [ 2 ]         ldab   #SEMA_a    wait on semaphore A
0093 e80d 3f                 [14 ]         swi
0094 e80e 01                                FCB    .wait.
0095                               
0096 e80f 86 01              [ 2 ] dqloop  ldaa   #TESTQ_1   dequeue from queue 1
0097 e811 3f                 [14 ]         swi
0098 e812 07                               FCB    .deque.
0099 e813 81 24              [ 2 ]         cmpa   #ENDOFQ    compare dequeued byte with end-of queue character
0100 e815 26 f8              [ 3 ]         bne    dqloop     loop until a match is found
0101                               
0102 e817 c6 03              [ 2 ]         ldab   #SEMA_b    signal semaphore B
0103 e819 3f                 [14 ]         swi
0104 e81a 02                               FCB    .signal.
0105                               
0106 e81b 4f                 [ 2 ]         clra
0107 e81c 3f                 [14 ]         swi               terminate self
0108 e81d 0b                               FCB    .terminate.
0109                               
0110                               *******************************************************************************
0111                               *task 3 todo's:
0112                               * 1.  Cause task 5 to become runnable.
0113                               *     Task 5 is a lower priority task therefore no task switch.
0114                               * 2.  Send a message to task 4 and wait upon the named semaphore (MSEMA).
0115                               *     Once MSEMA is signalled.
0116                               * 3.  Dequeue from Queue 2 (5 x 1) and put message at location $0010.
0117                               *     Compare message to expected message, then wait on named semaphore (SEMA_b)
0118                               *     Once SEMA_b is signalled.
0119                               * 4.  Resume task 4 from the suspended state.
0120                               *     Task 4 is a lower priority therefore no task switch.
0121                               * 5.  Suspend task 5 and self.
0122                               *     Once allowed to run due to resume ESR from task 4.
0123                               * 6.  Pend the named semaphore (SEMA_c) and wait for named semaphore (SEMA_d).
0124                               *     Once semaphore SEMA_d is signalled.
0125                               * 7.  Terminate task 5 and self.
0126                               *******************************************************************************
0127 e81e 86 05              [ 2 ] tsk3    ldaa   #T5        execute task 5
0128 e820 3f                 [14 ]         swi
0129 e821 0c                               FCB    .execute.
0130                               
0131 e822 cc e8 6b           [ 3 ]         ldd    #msgT3
0132 e825 dd 05              [ 4 ]         std    tstmsg+4   set up address of char string on msg body
0133 e827 86 04              [ 2 ]         ldaa   #T4        send message to task 4
0134 e829 5f                 [ 2 ]         clrb              use task semaphore
0135 e82a ce 00 01           [ 3 ]         ldx    #tstmsg
0136 e82d 3f                 [14 ]         swi
0137 e82e 05                               FCB    .sendw.
0138                               
0139 e82f 86 02              [ 2 ]         ldaa   #TESTQ_2
0140 e831 ce 00 10           [ 3 ]         ldx    #qdestn   set up destination address
0141 e834 3f                 [14 ]         swi
0142 e835 07                               FCB    .deque.
0143                               
0144 e836 86 05              [ 2 ]         ldaa   #msglen
0145 e838 ce e8 6b           [ 3 ]         ldx    #msgT3
0146 e83b 18 ce 00 10        [ 4 ]         ldy    #qdestn   set up source & destination addresses
0147 e83f e6 00              [ 4 ] cmploop ldab   0,x
0148 e841 18 e1 00           [ 5 ]         cmpb   0,y
0149 e844 26 24              [ 3 ]         bne    failT3
0150 e846 08                 [ 3 ]         inx
0151 e847 18 08              [ 4 ]         iny
0152 e849 4a                 [ 2 ]         deca
0153 e84a 26 f3              [ 3 ]         bne    cmploop
0154                               
0155 e84c c6 03              [ 2 ]         ldab   #SEMA_b    wait for semaphore B
0156 e84e 3f                 [14 ]         swi
0157 e84f 01                               FCB    .wait.
0158                               
0159 e850 86 04              [ 2 ]         ldaa   #T4       set up to resume task 4
0160 e852 3f                 [14 ]         swi
0161 e853 09                               FCB    .resume.
0162                               
0163 e854 86 05              [ 2 ]         ldaa   #T5       set up to suspend task 5
0164 e856 3f                 [14 ]         swi
0165 e857 0a                               FCB    .suspend.
0166                               
0167 e858 4f                 [ 2 ]         clra             set up to suspend self
0168 e859 3f                 [14 ]         swi
0169 e85a 0a                               FCB    .suspend.
0170                               
0171 e85b c6 04              [ 2 ]        ldab    #SEMA_C   pend on semaphore C
0172 e85d 3f                 [14 ]        swi
0173 e85e 03                              FCB    .pend.
0174                               
0175 e85f c6 05              [ 2 ]        ldab    #SEMA_D   wait on semaphore D
0176 e861 3f                 [14 ]        swi
0177 e862 01                              FCB    .wait.
0178                               
0179 e863 86 05              [ 2 ]        ldaa    #T5       terminate task 5
0180 e865 3f                 [14 ]        swi
0181 e866 0b                              FCB    .terminate.
0182                               
0183 e867 4f                 [ 2 ]        clra              terminate self
0184 e868 3f                 [14 ]        swi
0185 e869 0b                              FCB    .terminate.
0186                               
0187 e86a cf                 [ 2 ] failT3 stop              halt if matchup fails
0188                               
0189 e86b 41 42 43 44 45           msgT3  FCC     "ABCDE"
0190 0005                          msglen equ     *-msgT3
0191                               
0192                               *******************************************************************************
0193                               *task 4 todo's:
0194                               * 1.  Wait on message from task 3. Strip bytes from message.
0195                               * 2.  Enqueue stripped bytes into queue 2.
0196                               * 3.  Signal the named semaphore (MSEMA).
0197                               *     This will cause a task switch due to task 3 (waiting on MSEMA) is
0198                               *     a higher priority task.
0199                               * 4.  Purge the timer setup by task 5.
0200                               *     Once allowed to run again due to resume from task 3.    
0201                               * 6.  Signal named semaphores (SEMA_c) and (SEMA_d) and allow task 3 to run.
0202                               *     Since task 3 is a higher priority we will do a task switch.
0203                               * 7.  Setup a 10 second timer. Cause task 2 to execute from start.
0204                               *     Since task 2 is a higher priority we will do a task switch. 
0205                               *     Notice since we are executing task 2, which jumps to start of task 2
0206                               *     we are actually starting the whole test over. But item 8. below did not
0207                               *     run. However it will run as soon as the delay in task 2 is started.
0208                               *     Since no other task is in the run state except task 4. We will run
0209                               *     the terminate in item 8, once the delay of task 2 is started, and
0210                               *     then go to the null task.
0211                               * 8.  Terminate self.
0212                               *
0213                               ******************************************************************************
0214 e870 4f                 [ 2 ] tsk4    clra               set up to receive highest priority message
0215 e871 3f                 [14 ]          swi
0216 e872 06                                FCB    .receive.  receive the message from task 3
0217                               
0218 e873 df 08              [ 4 ]          stx    savptr     save ptr to message
0219 e875 ee 04              [ 5 ]          ldx    MBODY,x        get address of test text string
0220 e877 86 02              [ 2 ]          ldaa   #TESTQ_2   enqueue to queue 2
0221 e879 3f                 [14 ]          swi
0222 e87a 08                                FCB    .enque.
0223                               
0224 e87b de 08              [ 4 ]          ldx    savptr     restore message address
0225 e87d e6 03              [ 4 ]          ldab   MSEMA,x        get semaphore number to signal
0226 e87f 3f                 [14 ]          swi
0227 e880 02                                FCB    .signal.
0228                               
0229 e881 86 05              [ 2 ]          ldaa   #T5        Purge the 10 second timer set up by
0230 e883 5f                 [ 2 ]          clrb               task 5 and using the task semaphore.
0231 e884 ce 00 01           [ 3 ]          ldx    #1
0232 e887 3f                 [14 ]          swi
0233 e888 0f                                 FCB   .purge.
0234                               
0235 e889 4f                 [ 2 ]          clra
0236 e88a 3f                 [14 ]          swi
0237 e88b 0a                                FCB    .suspend.        suspend self
0238                               
0239 e88c c6 04              [ 2 ]          ldab   #SEMA_C    signal semaphore C
0240 e88e 3f                 [14 ]          swi
0241 e88f 02                                FCB    .signal.
0242                               
0243 e890 c6 05              [ 2 ]          ldab   #SEMA_D    signal semaphore D
0244 e892 3f                 [14 ]          swi
0245 e893 02                                FCB    .signal.
0246                               
0247 e894 86 03              [ 2 ]          ldaa   #T3        resume task 3
0248 e896 3f                 [14 ]          swi
0249 e897 09                                FCB    .resume.
0250                               
0251 e898 4f                 [ 2 ]          clra
0252 e899 5f                 [ 2 ]          clrb
0253 e89a ce 00 cc           [ 3 ]          ldx    #10000/49  Set up a 10 second timer for self.
0254 e89d 3f                 [14 ]          swi               This timer should disappear when the
0255 e89e 0e                                 FCB   .timer.      task is terminated.
0256                               
0257 e89f 86 02              [ 2 ]          ldaa   #T2        execute task 2
0258 e8a1 3f                 [14 ]          swi
0259 e8a2 0c                                FCB    .execute.
0260                                
0261 e8a3 4f                 [ 2 ]          clra              terminate task 4 (self)
0262 e8a4 3f                 [14 ]          swi
0263 e8a5 0b                                FCB    .terminate.
0264                               
0265                               ******************************************************************************
0266                               
0267                               *task 5 todo's:
0268                               * 1.  Setup a 10 second timer and cause task 4 to be runnable.
0269                               * 2.  Signal named semaphore (SEMA_a). Enqueue data to Queue 1.
0270                               ******************************************************************************
0271 e8a6 4f                 [ 2 ] tsk5     clra
0272 e8a7 5f                 [ 2 ]          clrb
0273 e8a8 ce 00 cc           [ 3 ]          ldx    #10000/49
0274 e8ab 3f                 [14 ]          swi               Set up a 10 second timer for self. This timer
0275 e8ac 0e                                 FCB   .timer.     will be purged by task 4.
0276                               
0277 e8ad 86 04              [ 2 ]          ldaa   #T4        execute task 4
0278 e8af 3f                 [14 ]          swi
0279 e8b0 0c                                FCB    .execute.
0280                               
0281 e8b1 c6 02              [ 2 ]          ldab   #SEMA_a    signal semaphore a
0282 e8b3 3f                 [14 ]          swi
0283 e8b4 02                                FCB    .signal.
0284                               
0285 e8b5 18 ce e8 c8        [ 4 ]          ldy    #lisT5     pointer to list of characters
0286 e8b9 cd ee 00           [ 6 ] enqloop  ldx    0,y        get next char from list
0287 e8bc 18 08              [ 4 ]          iny
0288 e8be 86 01              [ 2 ]          ldaa   #TESTQ_1   enqueue to queue 1
0289 e8c0 3f                 [14 ]          swi
0290 e8c1 08                                FCB    .enque.
0291                               
0292 e8c2 8f                 [ 3 ]          xgdx
0293                               ****(V1.4 #1) ****
0294 e8c3 81 24              [ 2 ]          cmpa   #ENDOFQ    look for end of queue                          |
0295 e8c5 26 f2              [ 3 ]          bne    enqloop
0296                                        
0297 e8c7 cf                 [ 2 ]          stop              should never get here.
0298                               
0299 e8c8 5a 59 58 24              lisT5    FCC    "ZYX$"
0300                               
0301                               *******************************************************************************
0302                               *   Now set up the starting addresses in the TCB                              *
0303                               *******************************************************************************
0304                               * Be sure to download SYSTEM.S19 into the EVM before loading the TEST.S19
0305                               * file. This will assure that the starting addresses will be overlayed into
0306                               * the task control blocks properly. These addresses are set up to the task 
0307                               * number in SYSTEM.AS file and therfore are not runnable.
0308                               ******************************************************************************
0309 e014                                   ORG  $E014
0310 e014 e8 00                             FDB  tsk2
0311                               
0312 e01b                                   ORG  $E01B
0313 e01b e8 1e                             FDB  tsk3
0314                               
0315 e022                                   ORG  $E022
0316 e022 e8 70                             FDB  tsk4
0317                               
0318 e029                                   ORG  $E029
0319 e029 e8 a6                             FDB  tsk5
0320                               
