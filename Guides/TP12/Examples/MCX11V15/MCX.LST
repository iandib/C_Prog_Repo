mcx.as                                       page   2
0630                               *******************************************************************************
0631                               *                                                                             *
0632                               *                       	MCX11 TASK DISPATCHER                             *
0633                               *                                                                             *
0634                               *******************************************************************************
0635                               *                                                                             *
0636                               * This is the code that looks for the highest priority task that is in a RUN  *
0637                               * state. The tsk's state is contained in the Task Control Block (TCB). The    *
0638                               * job of the Dispatcher is to find the task having the highest priority and   *
0639                               * is ready to take control, i.e., run. This is a tight loop because every     *
0640                               * time a task gives up control, except for a pre-emption, the Dispatcher is   *
0641                               * called to find the next task to run.                                        *
0642                               *                                                                             *
0643                               *******************************************************************************
0644                               
0645 e0d0 4f                 [ 2 ] dispch  clra                        Use acc A for the task number
0646 e0d1 ce 00 9c           [ 3 ]         ldx    #STATLS-TCBLEN       Set up base address of TCB list
0647 e0d4 7f 00 f4           [ 6 ] next    clr    curtsk               Set current task # to 0
0648 e0d7 8e 00 1f           [ 3 ]         lds    #SYSTACK             Load the system stack pointer address
0649 e0da c6 7f              [ 2 ]         ldab   #$7F                 Load constant 127 for presetting
0650 e0dc d7 f7              [ 3 ]         stab   hipri                  the task # of the highest priority task
0651                               *                                     - 1 is the highest priority
0652                               *                                     - 127 is the lowest priority
0653 e0de c6 05              [ 2 ]         ldab   #TCBLEN              Load a constant for TCB length attribute
0654 e0e0 0e                 [ 2 ]         cli                         Enable interrupts
0655 e0e1 4c                 [ 2 ] testat  inca                        Bump the task number by 1
0656 e0e2 3a                 [ 3 ]         abx                         Get address of next TCB
0657                               *** (V1.3 #8) ***
0658 e0e3 6d 00              [ 6 ]         tst    STATE,x              See if all bits in task's status are 0
0659 e0e5 26 fa              [ 3 ]         bne    testat               If not, go check the next task.
0660 e0e7 0f                 [ 2 ] switch  sei                         Task is ready to run. disable interrupts
0661 e0e8 97 f7              [ 3 ]         staa   hipri                Save task number as highest priority
0662 e0ea df f8              [ 4 ]         stx    pritcb               Save TCB address as that of hipri task
0663 e0ec 97 f4              [ 3 ] setcur  staa   curtsk                 also save acc A as current task number
0664 e0ee df f5              [ 4 ]         stx    curtcb               Save X-reg as address of curtsk's TCB
0665 e0f0 ae 01              [ 5 ] rtncur  lds    ACTSP,x              Load task's stack pointer from TCB
0666 e0f2 3b                 [12 ] intrtn  rti                         Go to task via an interrupt return. The
0667                               *                                     task's context is on the task's stack.
0668                               *                                     This treats the context switch as if it
0669                               *                                     is an interrupt (it is likely to be).
0670                               
0671                               *******************************************************************************
0672                               *                                                                             *
0673                               *                  	MCX11 COMMON INTERRUPT SERVICE RETURN                     *
0674                               *                                                                             *
0675                               *******************************************************************************
0676                               *                                                                             *
0677                               * This is the code that ALL interrupt service routines (ISR) MUST return thru *
0678                               * to complete the action of the interrupt. The ISR must have saved the MPU    *
0679                               * context, incremented the nested interrupt level (intlvl), and enabled other *
0680                               * interrupts before actually servicing the interrupt. Upon completion,  the   *
0681                               * ISR, should branch to this common interrupt return routine. The B accumu-   *
0682                               * lator  should  contain a semaphore  number or a zero.  The  former  value   *
0683                               * indicates that an event has occurred that requires action at the task level *
0684                               * and the latter indicates thee is no further action required.                *
0685                               *                                                                             *
0686                               * When ACCB contains a semaphore number, the semaphore is SIGNALed to inform  *
0687                               * any task associated with the event that it has occurred. A context switch   *
0688                               * will occur if the task in a WAIT state for that event is then ready to run  *
0689                               * and is of higher priority than the interrupted,i.e. current, task, and the  *
0690                               * level of nested interrupts is 1. A context switch will not occur if ALL of  *
0691                               * these conditions are not true. If the B accumulator contains a zero upon    *
0692                               * return from the ISR, there is an immediate return to the interrupted task   *
0693                               * if the level of nested interrupts is 1 or a return to the executive or to   *
0694                               * an interrupted ISR if the level of nested interrupts is >1.                 *
0695                               *                                                                             *
0696                               *******************************************************************************
0697                               *
0698 e0f3 5d                 [ 2 ] isrrtn  tstb                        Test ACCB for content
0699 e0f4 26 03              [ 3 ]         bne    signal2              If ACCB != 0, go signal the event. 
0700                               *                                     If ACCB = 0, return to point of interrupt
0701                               *
0702                               *** (V1.4 #2) ***
0703 e0f6 20 2f              [ 3 ]         bra    endtsk               Eliminated endfast routine.              |
0704                               
0705 e0f8 16                 [ 2 ] .signal tab                         *** PUT IN COMMENT BLOCK ***
0706                               signal2
0707 e0f9 ce 00 be           [ 3 ]         ldx    #FLGTBL-1            Got a semaphore number. Load address-1 of
0708 e0fc 3a                 [ 3 ]         abx                           semaphore table and add semaphore # to it
0709 e0fd 5f                 [ 2 ]         clrb                        Clear ACCB so that we will have a zero
0710 e0fe 0f                 [ 2 ]         sei                         Turn off interrupts  *** (V1.3 #2) ***
0711 e0ff a6 00              [ 4 ]         ldaa   0,x                  Get the content of the semaphore
0712 e101 2a 01              [ 3 ]         bpl    nowait               Branch if semaphore not in WAIT state
0713 e103 5c                 [ 2 ]         incb                        If WAITing, set it to PENDing
0714 e104 e7 00              [ 4 ] nowait  stab   0,x                  If PENDing or DONE, set to DONE
0715 e106 16                 [ 2 ]         tab                         Look at original content of semaphore
0716                               *** (V1.4 #2) ***
0717 e107 2a 1f              [ 3 ]         bpl    immrtn               Return immediately if semaphore not WAITing|
0718 e109 0e                 [ 2 ]         cli                         End of critical code  *** (V1.3 #2) ***
0719 e10a 50                 [ 2 ]         negb                        If WAITing, 2's complement = task # WAITing
0720                               *                                     for the event.
0721                               *** (V1.3 #3) ***
0722 e10b 86 bf              [ 2 ] 	ldaa   #-_WAIT-1            Store the 1's complement of the WAIT
0723 e10d 37                 [ 3 ] clrstat pshb                        Save the task number.
0724 e10e 36                 [ 3 ]         psha                        Then save the mask again.
0725 e10f 86 05              [ 2 ]         ldaa   #TCBLEN              Use the task number to compute the address
0726 e111 3d                 [10 ]         mul                           of its TCB
0727 e112 c3 00 9c           [ 4 ]         addd   #STATLS-TCBLEN
0728 e115 8f                 [ 3 ]         xgdx                        Put the TCB address in IX register
0729 e116 32                 [ 4 ]         pula                        Get the mask of bits to clear.
0730 e117 0f                 [ 2 ] clrbits sei
0731 e118 a4 00              [ 4 ]         anda   0,x                  Clear the byte as given by the mask.
0732 e11a a7 00              [ 4 ]         staa   0,x                  Save the updated TCB status byte.
0733 e11c 32                 [ 4 ]         pula                        Get the task number again.
0734 e11d 26 09              [ 3 ]         bne    immrtn               Branch to immediate exit if task's status
0735                               *                                     indicates it is not ready to run (!=0).
0736 e11f 91 f7              [ 3 ]         cmpa   hipri                If it is ready to run, is it of higher
0737                               *                                     priority than the current highest 
0738                               *                                     priority task which is ready to run?
0739 e121 2c 05              [ 3 ]         bge    immrtn               Branch if task priority < hipri.         
0740 e123 97 f7              [ 3 ]         sta    hipri                If so, then make it the new hipri task.
0741 e125 df f8              [ 4 ]         stx    pritcb               Save its TCB address too.
0742                               
0743 e127 0f                 [ 2 ] endtsk  sei                         Disable interrupts
0744 e128 7a 00 fa           [ 6 ] immrtn  dec    intlvl               Decrement the interrupt level.
0745 e12b 26 c5              [ 3 ]         bne    intrtn               If it is >0, then the interrupt occurred
0746                               *                                     while we were doing system operations.
0747 e12d 96 f4              [ 3 ]         ldaa   curtsk               See if the current task is 0.
0748 e12f 26 07              [ 3 ]         bne    notdisp              If not, branch.
0749 e131 30                 [ 3 ]         tsx                         If so, the MCX11 Dispatcher was interrupted
0750                               *                                     See what task was being checked when the
0751                               *                                     interrupt occurred. The context of the
0752                               *                                     Dispatcher is found on the system stack.
0753 e132 a6 02              [ 4 ]         ldaa   ACCA,x               Get the content of ACCA from the stack as
0754                               *                                     it holds the value of the "current task"
0755                               *                                     being used by the Dispatcher.
0756 e134 91 f7              [ 3 ]         cmpa   hipri                Compare it to hipri task number.
0757 e136 2f ba              [ 3 ]         ble    intrtn               The "current task" is of higher priority.
0758 e138 de f8              [ 4 ] notdisp ldx    pritcb               Get the hipri task's TCB address
0759 e13a 96 f7              [ 3 ]         ldaa   hipri                and set up the hipri task number.
0760 e13c 1f 00 ff ac        [ 7 ]         brclr  STATE,x $FF setcur   If task is ready to run, go to it
0761 e140 20 92              [ 3 ] 	bra    next                 Otherwise, look for next lower priority
0762                               *                                     task that is ready to run.
0763                               
0764                               *******************************************************************************
0765                               *                                                                             *
0766                               *                    MCX11 EXECUTIVE SERVICES DISPATCHER                      *
0767                               *                                                                             *
0768                               *******************************************************************************
0769                               *                                                                             *
0770                               * The Executive Services Dispatcher is the heart of MCX11. This is the point  *
0771                               * to which all Executive Service Requests (ESR) are vectored. The ESR Dis-    *
0772                               * patcher takes the function code of the ESR requested by the task and uses   *
0773                               * it as an index into a jump table to the various ESR functions. This code is *
0774                               * entered by a SWI instruction so it must be treated as a special kind of     *
0775                               * interrupt. The nested interrupt level is always =0 upon entry because the   *
0776                               * ESR is coming from a task. The ESR function is always found at the byte     *
0777                               * immediately following the SWI.                                              *
0778                               *                                                                             *
0779                               *******************************************************************************
0780                               
0781 e142 7c 00 fa           [ 6 ] mcxsrv  inc    intlvl               Increment the interrupt nest level
0782 e145 de f5              [ 4 ]         ldx    curtcb
0783 e147 af 01              [ 5 ]         sts    ACTSP,x              Save SP in TCB of current task
0784 e149 18 30              [ 4 ]         tsy                         Save Top-of-Stack (TOS) in IY. This will
0785                               *                                     actually point to the CCR byte
0786 e14b 8e 00 1f           [ 3 ]         lds    #SYSTACK             Load SP with address of system stack
0787 e14e 0e                 [ 2 ]         cli                         Now interrupts are turned on
0788 e14f cd ee 07           [ 6 ]         ldx    PC,y                 Set up pointer to the ESR function
0789 e152 e6 00              [ 4 ]         ldab   0,x                  Get the ESR function code
0790 e154 08                 [ 3 ]         inx                         Bump the return address by 1
0791 e155 cd ef 07           [ 6 ]         stx    PC,y                 Save the return address
0792 e158 58                 [ 2 ]         aslb                        Multiply the ESR function code by 2
0793 e159 ce e1 64           [ 3 ]         ldx    #jtable              Load address of the ESR jump table
0794 e15c 3a                 [ 3 ]         abx                         Add function code*2 to base address of
0795                               *                                     jump table to get ESR vector
0796 e15d ee 00              [ 5 ]         ldx    0,x                  Load the ESR vector into IX
0797 e15f 18 ec 01           [ 6 ]         ldd    ACCB,y               Load up ACCA and ACCB with the arguments
0798                               *                                     as passed by the calling task but
0799                               *                                     switch ACCA and ACCB contents.
0800                               
0801                               *******************************************************************************
0802                               *                                                                             *
0803                               * At this point the processor context is as follows:                          *
0804                               *                                                                             *
0805                               *              CCR       conditions wrt contents of ACCB & ACCA (don't use)   *
0806                               *              ACCA      ACCB as passed from calling task (ESR dependent)     *
0807                               *              ACCB      ACCA as passed from calling task (ESR dependent)     *
0808                               *              IX        Address of the ESR function                          *
0809                               *              IY        Address of task's Top-of-Stack (CCR byte)            *
0810                               *              SP        Base of System Stack                                 *
0811                               *                                                                             *
0812                               * In addition, the nested interrupt level is = 1, curtsk  and hipri are set   *
0813                               * to the number of the calling task, and curtcb and hipri both contain the    *
0814                               * address of the current task's TCB.                                          *
0815                               *                                                                             *
0816                               *******************************************************************************
0817                               
0818 e162 6e 00              [ 3 ]         jmp    0,x                  Go to the ESR function
0819                               
0820                               *******************************************************************************
0821                               *                                                                             *
0822                               *                              ESR JUMP TABLE                                 *
0823                               *                                                                             *
0824                               *******************************************************************************
0825                               
0826 e164 e1 27                    jtable  FDB    endtsk               0  = Immediate return (NOP)
0827 e166 e1 84                            FDB    .wait                1  = Wait for an event
0828 e168 e0 f8                            FDB    .signal              2  = Signal a semaphore
0829 e16a e1 a3                            FDB    .pend                3  = Set a semaphore to PENDing state
0830 e16c e1 b7                            FDB    .send                4  = Send a task a message without waiting
0831 e16e e1 b6                            FDB    .sendw               5  = Send a task a message with wait
0832 e170 e2 17                            FDB    .recv                6  = Receive a message
0833 e172 e2 65                            FDB    .deque               7  = Dequeue an entry from a FIFO queue
0834 e174 e2 e1                            FDB    .enque               8  = Enqueue an entry into a FIFO queue
0835 e176 e3 29                            FDB    .resume              9  = Resume a task in suspension
0836 e178 e3 2e                            FDB    .suspnd              10 = Suspend a task's operation
0837 e17a e3 42                            FDB    .termn8              11 = Terminate a task's operaton
0838 e17c e3 5d                            FDB    .xeqt                12 = Execute a task
0839 e17e e3 83                            FDB    .delay               13 = Delay a task for a period of time
0840 e180 e3 85                            FDB    .timer               14 = Set up a timer
0841 e182 e4 21                            FDB    .purge               15 = Remove a given timer from active state
0842                               
0843                               
0844                               * ESR1
0845                               *******************************************************************************
0846                               *                                                                             *
0847                               * WAIT for an event to occur. This ESR is used to place the calling task into *
0848                               * a WAIT state where it will remain until the event happens. If the event has *
0849                               * already occurred, the wait does not happen and control is immediately re-   *
0850                               * turned to the calling task. WAIT is always associated with a semaphore. The *
0851                               * semaphore can be explicitly stated or it can be implicit, i.e. the task's   *
0852                               * semaphore. Regardless of how the semaphore is defined in the ESR, the sema- *
0853                               * phore must be in the PENDing state if the WAIT is to occur. The process     *
0854                               * handling the signaling of the event when it occurs must have prior know-    *
0855                               * ledge that the event uses a particular semaphore. Only in this way can the  *
0856                               * waiting task and the signalling task be connected.                          *
0857                               *                                                                             *
0858                               * calling sequence:                                                           *
0859                               *                                                                             *
0860                               *                   ACCB = semaphore number                                   *
0861                               *                   swi                                                       *
0862                               *                    FCB   .wait.                                                   *
0863                               *                   return: all registers unchanged                           *
0864                               *                                                                             *
0865                               *******************************************************************************
0866                               
0867 e184 16                 [ 2 ] .wait   tab                        Test the semaphore number
0868 e185 26 04              [ 3 ]         bne    wait2               If it is defined, go set up the wait
0869 e187 d6 f4              [ 3 ]         ldab   curtsk              Otherwise use the task's semaphore
0870 e189 cb 08              [ 2 ]         addb   #NNAMSEM
0871 e18b ce 00 be           [ 3 ] wait2   ldx    #FLGTBL-1
0872 e18e 3a                 [ 3 ]         abx                        Compute address of the semaphore
0873 e18f 0f                 [ 2 ] 	sei			   Start of critical code  *** (V1.3 #4) ***
0874 e190 6d 00              [ 6 ]         tst    0,x                 Test the semaphore contents
0875 e192 2b 07              [ 3 ]         bmi    waitt               Branch if already in the WAIT state
0876                               *				     This is a safety net, if you should unin-
0877                               *                                    tentionally have more than one task wait-
0878                               *				     ing on a semaphonre at a time all but the
0879                               *				     first will not wake up unless they are re-
0880                               *				     exicuted.
0881 e194 27 18              [ 3 ]         beq    pendset             If DONE, go reset to PENDing and return
0882 e196 96 f4              [ 3 ] force   ldaa   curtsk              If state of semaphore is PENDing, the
0883 e198 40                 [ 2 ]         nega                         event has not yet occurred so
0884 e199 a7 00              [ 4 ]         staa   0,x                 Set the semaphore to WAIT on current task.
0885 e19b de f5              [ 4 ] waitt   ldx    curtcb              Get current task's TCB address
0886 e19d 1c 00 40           [ 7 ]         bset   STATE,x _WAIT       Set the WAIT state in task's status byte.
0887                               *** (V1.3 #4) ***
0888 e1a0 7e e1 28           [ 3 ]         jmp    immrtn		   Critical code ends at actual return to task
0889                               
0890                               *******************************************************************************
0891                               *                                                                             *
0892                               * Force a semaphore to a PENDing state. This function should be used to make  *
0893                               * sure that a semaphore is in the correct state if there is some doubt. A     *
0894                               * semaphore must be in a PENDing state before it can transition to a WAITing  *
0895                               * state. All semaphores should be initialized to a PENDing state at the time  *
0896                               * of system initialization. After that, they are generally maintained by the  *
0897                               * .wait and .signal functions. However, it may become necessary at some time  *
0898                               * to set a given semaphore PENDing to insure that the event is recognized as  *
0899                               * having yet occurred.                                                        *
0900                               *                                                                             *
0901                               * calling sequence:                                                           *
0902                               *                                                                             *
0903                               *                   ACCB = semaphore number                                   *
0904                               *                   swi                                                       *
0905                               *                    FCB   .pend.                                                   *
0906                               *                   return: all registers unchanged                           *
0907                               *                                                                             *
0908                               *******************************************************************************
0909                               
0910 e1a3 16                 [ 2 ] .pend   tab                        Put semaphore number in ACCB
0911 e1a4 26 04              [ 3 ]         bne    dopend              Branch if semaphore is defined.
0912 e1a6 d6 f4              [ 3 ]         ldab   curtsk              Else use task semaphore.
0913 e1a8 cb 08              [ 2 ]         addb   #NNAMSEM
0914 e1aa ce 00 be           [ 3 ] dopend  ldx    #FLGTBL-1           Compute the address of the given semaphore.
0915 e1ad 3a                 [ 3 ]         abx
0916 e1ae 86 01              [ 2 ] pendset ldaa   #_PEND              Set the semaphore to pending
0917 e1b0 0f                 [ 2 ]         sei
0918 e1b1 a7 00              [ 4 ]         staa   0,x
0919 e1b3 7e e1 28           [ 3 ]         jmp    immrtn              All done.
0920                               
0921                               *******************************************************************************
0922                               *                                                                             *
0923                               * Send a message and wait for reply. This function is the same as the .send.  *
0924                               * function except that it puts the sender into a Wait state until the task    *
0925                               * receiving the message signals the semaphore to indicate it is finished.     *
0926                               *                                                                             *
0927                               * calling sequence:                                                           *
0928                               *                                                                             *
0929                               *                   ACCA = Task number of the receiver                        *
0930                               *                   ACCB = Semaphore number                                   *
0931                               *                   IX = Message address                                      *
0932                               *                   swi                                                       *
0933                               *                    FCB   .sendw.                                                  *
0934                               *                   return: Registers are unchanged                           *
0935                               *                           ACCB will = Current task # if the semaphore       *
0936                               *                             number was = 0 at the time of the ESR           *
0937                               *                                                                             *
0938                               *******************************************************************************
0939                               
0940 e1b6 5f                 [ 2 ] .sendw  clrb                       Set switch = 0 for .sendw.
0941                               
0942                               *******************************************************************************
0943                               *                                                                             *
0944                               * Send a message. This function sends a message but does not wait for a reply *
0945                               * to be returned from the receiver. There is a semaphore associated with the  *
0946                               * message but it is set to a PENDing state. The Sending task may perform a    *
0947                               * .wait. on that semaphore at a later time if necessary. Neither .send. nor   *
0948                               * .sendw. moves data from the sender to the receiver. Instead, only the       *
0949                               * pointer to the message is moved. Each task has a threaded list of messages  *
0950                               * which it can receive. The threaded list entry is the pointer to the message.*
0951                               * The message pointer is inserted into the threaded list in the order of the  *
0952                               * sending task's priority.                                                    *
0953                               *                                                                             *
0954                               * calling sequence:                                                           *
0955                               *                                                                             *
0956                               *                   ACCA = Task number of the receiver                        *
0957                               *                   ACCB = Semaphore number                                   *
0958                               *                   IX = Message address                                      *
0959                               *                   swi                                                       *
0960                               *                    FCB   .send.                                                   *
0961                               *                   return: Registers are unchanged                           *
0962                               *                           ACCB will = Task semaphore # if ACCB was = 0      *
0963                               *                                       at the time of the ESR.               *
0964                               *                                                                             *
0965                               *******************************************************************************
0966                               
0967 e1b7 37                 [ 3 ] .send   pshb                       Save the switch. Switch > 0 for .send
0968 e1b8 18 e6 01           [ 5 ]         ldab   ACCB,y              Get the semaphore number for the message.
0969 e1bb 26 07              [ 3 ]         bne    havsema             Branch if semaphore # > 0.
0970 e1bd d6 f4              [ 3 ]         ldab   curtsk              If semaphore # = 0, use task semaphore.
0971 e1bf cb 08              [ 2 ]         addb   #NNAMSEM
0972 e1c1 18 e7 01           [ 5 ]         stab   ACCB,y
0973 e1c4 ce 00 be           [ 3 ] havsema ldx    #FLGTBL-1
0974 e1c7 3a                 [ 3 ]         abx                        Compute address of the semaphore.
0975 e1c8 33                 [ 4 ]         pulb                       Get the send switch.
0976 e1c9 5d                 [ 2 ]         tstb                       Test switch.
0977 e1ca 26 03              [ 3 ]         bne    notw                Branch if switch set for no waiting.
0978 e1cc 96 f4              [ 3 ]         ldaa   curtsk              
0979 e1ce 40                 [ 2 ]         nega                       If switch set for wait, set -task #.
0980 e1cf a7 00              [ 4 ] notw    staa   0,x                 Set the semaphore to proper value.
0981 e1d1 de f5              [ 4 ]         ldx    curtcb              Get address of current task's TCB.
0982 e1d3 5d                 [ 2 ]         tstb                       Test the switch again.
0983 e1d4 26 03              [ 3 ]         bne    waitnot
0984 e1d6 1c 00 40           [ 7 ]         bset   STATE,x _WAIT       Set the sender's status to WAITing.
0985 e1d9 18 a6 02           [ 5 ] waitnot ldaa   ACCA,y              Get the receiving task #.
0986 e1dc 36                 [ 3 ]         psha                       Save it for later use, too.
0987 e1dd c6 05              [ 2 ]         ldab   #TCBLEN
0988 e1df 3d                 [10 ]         mul                        Compute TCB address of receiving task.
0989 e1e0 c3 00 9c           [ 4 ]         addd   #STATLS-TCBLEN
0990 e1e3 8f                 [ 3 ]         xgdx
0991 e1e4 3c                 [ 4 ]         pshx                       Save TCB address for later use.
0992 e1e5 c6 03              [ 2 ]         ldab   #MSGTHRD
0993 e1e7 3a                 [ 3 ]         abx
0994 e1e8 18 a6 01           [ 5 ]         ldaa   ACCB,y              Get the semaphore number
0995 e1eb 18 ee 03           [ 6 ]         ldy    IX,y                Load IY with message address.
0996 e1ee 18 a7 03           [ 5 ]         staa   MSEMA,y             Set up semaphore # in message header.
0997 e1f1 96 f4              [ 3 ]         ldaa   curtsk
0998 e1f3 18 a7 02           [ 5 ]         staa   MTASK,y             Set up current task as sender.
0999 e1f6 18 3c              [ 5 ]         pshy                       Save address of the message header.
1000 e1f8 1a ee 00           [ 6 ] nsrtlp  ldy    MLINK,x             Look at the receiver's next message address.
1001 e1fb 27 09              [ 3 ]         beq    insert              If pointer = 0, End-of=List. Go insert here.
1002 e1fd 18 a1 02           [ 5 ]         cmpa   MTASK,y             If there is a message on the thread, look at
1003                               *                                    the task number of its sender and compare
1004                               *                                    it to the sender's task number for this
1005                               *                                    new message.
1006                               *
1007 e200 25 04              [ 3 ]         blo    insert              If the new message's sender has a priority |
1008                               *                                    higher than that of the threaded message,|
1009                               *                                    go insert the new message pointer in front
1010                               *                                    of the one on the list. (V1.1 #4)        |
1011 e202 ee 00              [ 5 ]         ldx    MLINK,x             Otherwise, walk the thread.
1012 e204 20 f2              [ 3 ]         bra    nsrtlp              Keep looking for a place to insert new msg.
1013 e206 18 8f              [ 4 ] insert  xgdy                       Put address of next nessage in ACCD.
1014 e208 18 38              [ 6 ]         puly                       Get address of new message's header.
1015 e20a 18 ed 00           [ 6 ]         std    MLINK,y             Link new message into threrad.
1016 e20d 18 8f              [ 4 ]         xgdy
1017 e20f ed 00              [ 5 ]         std    MLINK,x
1018 e211 38                 [ 5 ]         pulx                       Get address of TCB of receiver again. 
1019                               ***(V1.3 #5)***
1020 e212 86 df              [ 2 ]         ldaa   #-_RCVWAT-1
1021 e214 7e e1 17           [ 3 ]         jmp    clrbits             Go clear the receiver wait, if any.
1022                               
1023                               *******************************************************************************
1024                               *                                                                             *
1025                               * Receive a message. This function is used by a receiving task to get the     *
1026                               * next message from the task's message thread. Normally, the next message is  *
1027                               * pointed to by the content of the message thread pointer in the task's TCB.  *
1028                               * However, it is also possible to get the next message sent from a given task *
1029                               * to the receiver task. By this technique, the receiver may effectively ig-   *
1030                               * nore other senders and reserve all activity for the one sending task. This  *
1031                               * is useful in designing server tasks which need to insure the dedicated use  *
1032                               * of a given resource.                                                        *
1033                               *                                                                             *
1034                               * calling sequence:                                                           *
1035                               *                                                                             *
1036                               *                   ACCA = task number (Otherwise this must be 0)             *
1037                               *                   swi                                                       *
1038                               *                    FCB   .recv.                                                   *
1039                               *                   return: IX contains the address of the received message   *
1040                               *                           All other registers unchanged                     *
1041                               *                                                                             *
1042                               *******************************************************************************
1043                               
1044 e217 de f5              [ 4 ] .recv   ldx    curtcb              Set up to see if there is a special task
1045 e219 5d                 [ 2 ]         tstb                       ACCB holds the task number or 0.
1046 e21a 26 20              [ 3 ]         bne    special             If ACCB != 0, it contains the task number.
1047 e21c ec 03              [ 5 ]         ldd    MSGTHRD,x           If not given task #, get next message.
1048 e21e 27 0d              [ 3 ]         beq    waitrcv             See if message thread is null. (=0)
1049 e220 18 ed 03           [ 6 ]         std    IX,y                It's not. We have a message. Save address.
1050 e223 18 8f              [ 4 ]         xgdy
1051 e225 18 ec 00           [ 6 ]         ldd    0,y                 Then unlink the message from the thread.
1052 e228 ed 03              [ 5 ]         std    MSGTHRD,x
1053 e22a 7e e1 27           [ 3 ]         jmp    endtsk              Wrap it up.
1054                               *** (V1.3 #5) ***
1055 e22d 1c 00 20           [ 7 ] waitrcv bset   STATE,x _RCVWAT       If no message available, set up a RCVWAT
1056                               *** (V1.2 #1) *** 
1057 e230 18 ec 07           [ 6 ]         ldd    PC,y                Then back up the PC in the stacked         |
1058 e233 83 00 02           [ 4 ]         subd   #2                   context by 2 bytes                        |
1059 e236 18 ed 07           [ 6 ]         std    PC,y                                                           |
1060 e239 7e e1 27           [ 3 ]         jmp    endtsk              Go to wrap up routine                      |
1061                               
1062 e23c 18 3c              [ 5 ] special pshy                       Save address of the task's stack context.
1063 e23e c6 03              [ 2 ]         ldab   #MSGTHRD            ACCB still contains the task number.
1064 e240 3a                 [ 3 ]         abx                        Adjust IX to point to message thread pntr.
1065 e241 18 e6 02           [ 5 ]         ldab   ACCA,y              Get the task number again.
1066 e244 1a ee 00           [ 6 ] rcvloop ldy    0,x                 Get the address of the next message header.
1067 e247 27 e4              [ 3 ]         beq    waitrcv             If no message available, go wait for one.
1068 e249 18 e1 02           [ 5 ]         cmpb   MTASK,y             Compare the sender's task number to special
1069 e24c 27 06              [ 3 ]         beq    rcvgo                 task number. If a match, go to it.
1070 e24e 2d dd              [ 3 ]         blt    waitrcv               If special task number < sender's, wait.
1071 e250 ee 00              [ 5 ]         ldx    0,x                 If special task number > special, set up IX
1072 e252 20 f0              [ 3 ]         bra    rcvloop               to point to current message header and
1073                               *                                    then go check next message.
1074 e254 18 8f              [ 4 ] rcvgo   xgdy                       We have a message. Put its address in ACCD.
1075 e256 18 38              [ 6 ]         puly                       Then set up IY to point to the stack context
1076 e258 18 ed 03           [ 6 ]         std    IX,y                Store the message address in the IX register
1077                               *                                    of the receiving task's stack context.
1078 e25b 18 8f              [ 4 ]         xgdy                       Then put the pointer back into IY.
1079 e25d 18 ec 00           [ 6 ]         ldd    0,y                 Unlink the message from the thread.
1080 e260 ed 00              [ 5 ]         std    0,x
1081 e262 7e e1 27           [ 3 ]         jmp    endtsk              Go wrap it up.
1082                               
1083                               
1084                               *******************************************************************************
1085                               *                                                                             *
1086                               * Dequeue an element from a FIFO queue. This function is used to remove an    *
1087                               * element from a FIFO (First in- First out) queue. The queue is divided into  *
1088                               * two parts, the queue header and the queue body. The queue header contains   *
1089                               * all of the information about the state of the queue body. An attempt to re- *
1090                               * move an entry from an empty queue will place the caller into a wait state.  *
1091                               * When the queue has something put into it, the waiting task will be resumed. *
1092                               * Queue entries can be of any size but each queue handles only one size of    *
1093                               * entry.                                                                      *
1094                               *                                                                             *
1095                               * calling sequence:                                                           *
1096                               *                                                                             *
1097                               *                   ACCA = Queue number                                       *
1098                               *                   IX =   Destination address of dequeued entry of           *
1099                               *                            size > 2 bytes. Otherwise ignored.               *
1100                               *                   swi                                                       *
1101                               *                    FCB   .deque.                                                  *
1102                               *                   return: For an entry size of 1 byte:                      *
1103                               *                            ACCA = dequeued entry                            *
1104                               *                           For an entry size of 2 bytes:                     *
1105                               *                            ACCA = byte 1 of entry                           *
1106                               *                            ACCB = byte 2 of entry                           *
1107                               *                           Other registers unchanged                         *
1108                               *                                                                             *
1109                               *******************************************************************************
1110                               
1111 e265 8d 5f              [ 6 ] .deque  bsr    qsetup              Set up the queue header information
1112                               *                                    The queue depth and width are moved to
1113                               *                                    RAM work area as is the Not Empty sema-
1114                               *                                    phore. The address of the queue body is
1115                               *                                    in RAM at location "temp".
1116 e267 e6 00              [ 4 ]         ldab   CURSIZ,x            Check current size of queue to see if empty.
1117 e269 27 44              [ 3 ]         beq    qempty              Branch if queue is empty.
1118 e26b 3c                 [ 4 ]         pshx                       Save the queue header address.
1119 e26c a6 01              [ 4 ]         ldaa   PIX,x               Not empty. Get the Put Index and subtract
1120 e26e 10                 [ 2 ]         sba                          the Current Size from it.
1121 e26f 24 02              [ 3 ]         bhs    nowrap              Check for wrap around.
1122 e271 9b fe              [ 3 ]         adda   depth               If so, add Depth of queue.
1123 e273 d6 fd              [ 3 ] nowrap  ldab   width               ACCA = Get Index. Load ACCB with Width of
1124 e275 37                 [ 3 ]         pshb                         an entry. Also save the width for later.
1125 e276 6a 00              [ 6 ]         dec    CURSIZ,x            Decrement the Current Size of the queue by 1
1126 e278 3d                 [10 ]         mul                        Now multiply the Width times the Get Index
1127 e279 d3 fb              [ 5 ]         addd   temp                  and add the base address of the queue body
1128 e27b 8f                 [ 3 ]         xgdx                         to get address of the entry to dequeue.
1129 e27c 32                 [ 4 ]         pula                       Get the Width again
1130 e27d 81 02              [ 2 ]         cmpa   #2                  Is it > 2 bytes?
1131 e27f 2e 15              [ 3 ]         bgt    dqgt2               Branch if width > 2 bytes.
1132 e281 2c 07              [ 3 ]         bge    dq2                 See if Width = 2 bytes and branch if so.
1133 e283 e6 00              [ 4 ]         ldab   0,x                 Width = 1 byte. Get it.
1134                               **(V1.1 #1)**
1135 e285 18 e7 02           [ 5 ]         stab   ACCA,y              Store it in ACCA of the stack context.     |
1136 e288 20 1a              [ 3 ]         bra    dqend               That's it.
1137 e28a e6 00              [ 4 ] dq2     ldab   0,x                 For Width = 2 bytes, get the 1st byte
1138 e28c 18 e7 02           [ 5 ]         stab   ACCA,y                and store it in ACCA of stack context.
1139 e28f e6 01              [ 4 ]         ldab   1,x                 Then get the 2nd byte and store in in ACCB
1140 e291 18 e7 01           [ 5 ]         stab   ACCB,y                of the stack context.
1141 e294 20 0e              [ 3 ]         bra    dqend               And that's that for size = 2.
1142 e296 18 ee 03           [ 6 ] dqgt2   ldy    IX,y                For Width > 2 bytes, get the destination
1143                               *                                    address from IX of the stack context.
1144 e299 e6 00              [ 4 ] dqloop  ldab   0,x                 Get next byte from queue body.
1145 e29b 18 e7 00           [ 5 ]         stab   0,y                 Move it to next byte of the destination.
1146 e29e 08                 [ 3 ]         inx
1147 e29f 18 08              [ 4 ]         iny
1148 e2a1 4a                 [ 2 ]         deca                       Decrement the Width count.
1149 e2a2 26 f5              [ 3 ]         bne    dqloop              Loop until count is = 0.
1150 e2a4 38                 [ 5 ] dqend   pulx                       When done, get the queue header address.
1151 e2a5 e6 02              [ 4 ]         ldab   QSEMA,x             Get the Queue NOT FULL semaphore #
1152 e2a7 27 79              [ 3 ]         beq    nopost              See if anyone is waiting for NOT FULL.
1153 e2a9 4f                 [ 2 ] postem  clra                       There is. Go signal the semaphore.
1154 e2aa a7 02              [ 4 ]         staa   QSEMA,x             But first, set the active semaphore # = 0
1155 e2ac 7e e0 f9           [ 3 ]         jmp    signal2
1156 e2af db ff              [ 3 ] qempty  addb   notmt               Queue is empty. Set up a wait state for this
1157 e2b1 e7 02              [ 4 ]         stab   QSEMA,x               task on the Queue NOT EMPTY semaphore
1158                               ** (V1.2 #2) **
1159 e2b3 37                 [ 3 ] backup  pshb                       Save the semaphore number                  |
1160 e2b4 18 ec 07           [ 6 ]         ldd    PC,y                Here we have to back up the PC by 2 bytes  |
1161 e2b7 83 00 02           [ 4 ]         subd   #2                    so that when the task restarts, it will  |
1162                               *                                    be at the SWI used to call MCX11.        |
1163 e2ba 18 ed 07           [ 6 ]         std    PC,y                Save the decremented PC                    |
1164 e2bd 33                 [ 4 ]         pulb                       Get the semaphore number.                  |
1165 e2be ce 00 be           [ 3 ]         ldx    #FLGTBL-1                                                      |
1166 e2c1 3a                 [ 3 ]         abx                        Calculate address of semaphore.            |
1167                               *** (V1.3 #6) ***
1168 e2c2 0f                 [ 2 ] 	sei			   Prepare to enter critical code
1169 e2c3 7e e1 96           [ 3 ]         jmp    force               Go set the wait state and clean up.        |
1170                               
1171 e2c6 4f                 [ 2 ] qsetup  clra
1172 e2c7 58                 [ 2 ]         aslb                       Multiply the queue number by the length
1173 e2c8 37                 [ 3 ]         pshb                       Save queue number * 2.
1174 e2c9 18 eb 02           [ 5 ]         addb   ACCA,y                of the queue initialization data block.
1175 e2cc 58                 [ 2 ]         aslb
1176 e2cd c3 df fa           [ 4 ]         addd   #QUEDATA-QUEDATL    Then add the address of the queue init data
1177 e2d0 8f                 [ 3 ]         xgdx
1178 e2d1 33                 [ 4 ]         pulb                       Get queue number * 2 and add the number of
1179 e2d2 cb 0c              [ 2 ]         addb   #NNAMSEM+NTASKS-1     named semaphores + the number of tasks
1180 e2d4 d7 ff              [ 3 ]         stab   notmt                 to get the NOT EMPTY semaphore #.
1181 e2d6 ec 00              [ 5 ]         ldd    WIDTH,x             Get the width and depth of the queue
1182 e2d8 dd fd              [ 4 ]         std    width               Store them in the work area of RAM.
1183 e2da ec 04              [ 5 ]         ldd    QADDR,x             Get the queue body address
1184 e2dc dd fb              [ 4 ]         std    temp                Store it in temp word in RAM
1185 e2de ee 02              [ 5 ]         ldx    QHADR,x             Get the Queue Header address
1186 e2e0 39                 [ 5 ]         rts                        Return
1187                               
1188                               *******************************************************************************
1189                               *                                                                             *
1190                               * Enqueue an element into a FIFO queue. This function is used to insert an    *
1191                               * element into a FIFO (First in- First out) queue. The queue is divided into  *
1192                               * two parts, the queue header and the queue body. The queue header contains   *
1193                               * all of the information about the state of the queue body. An attempt to in- *
1194                               * sert an entry into a full queue  will place  the caller into a wait state.  *
1195                               * When the queue has something taken out of it, the waiting task will be      *
1196                               * resumed. Queue entries can be of any size but each queue handles only one   *
1197                               * size of entry.                                                              *
1198                               *                                                                             *
1199                               * calling sequence:                                                           *
1200                               *                                                                             *
1201                               *                   ACCA = Queue number                                       *
1202                               *                   IX =   Source address of entry to be enqueued if          *
1203                               *                            size > 2 bytes.                                  *
1204                               *                          Or, IX8-15 = byte to be enqueued if size = 1       *
1205                               *                          Or, IX8-15 = byte 1 and IX0-7 = byte 2 if size = 2 *
1206                               *                   swi                                                       *
1207                               *                    FCB   .enque.                                            *
1208                               *                   return: Registers are unchanged                           *
1209                               *                                                                             *
1210                               *******************************************************************************
1211                               
1212 e2e1 8d e3              [ 6 ] .enque  bsr    qsetup              Set up the queue header information
1213 e2e3 96 fe              [ 3 ]         ldaa   depth               Compare DEPTH of queue to its Current Size
1214 e2e5 a1 00              [ 4 ]         cmpa   CURSIZ,x              to see if it is full.
1215 e2e7 27 3c              [ 3 ]         beq    full                Branch if queue is full.
1216 e2e9 3c                 [ 4 ]         pshx                       Save address of the queue header.
1217 e2ea a1 01              [ 4 ]         cmpa   PIX,x               Compare the depth to the Put Index to see
1218 e2ec 2e 03              [ 3 ]         bgt    wrapnot               if there is an address wrap around.
1219 e2ee 4f                 [ 2 ]         clra
1220 e2ef a7 01              [ 4 ]         staa   PIX,x               If a wrap around, reset Put Index to 0.
1221 e2f1 96 fd              [ 3 ] wrapnot ldaa   width               Then use the width and the Put index to
1222 e2f3 36                 [ 3 ]         psha                         compute the destination address in the 
1223 e2f4 e6 01              [ 4 ]         ldab   PIX,x                 queue body.
1224 e2f6 3d                 [10 ]         mul
1225 e2f7 d3 fb              [ 5 ]         addd   temp   
1226 e2f9 6c 01              [ 6 ]         inc    PIX,x               Bump the Put Index
1227 e2fb 6c 00              [ 6 ]         inc    CURSIZ,x            Bump the Current Size
1228                               *** (V1.3 #7) ***
1229 e2fd 18 ee 03           [ 6 ]         ldy    IX,y                Get data to be enqueued or pointer to it.
1230 e300 8f                 [ 3 ]         xgdx                       Move destination address into IX.
1231 e301 32                 [ 4 ]         pula                       Get the Width again.
1232 e302 81 02              [ 2 ]         cmpa   #2                  See if Width > 2 bytes.
1233 e304 2e 0c              [ 3 ]         bgt    nqloop              Branch if Width > 2 bytes
1234 e306 18 8f              [ 4 ]         xgdy                       If not, the data is in IY. Put it in ACCD.
1235 e308 27 04              [ 3 ]         beq    nq2                 Branch if Width = 2 bytes.
1236                               ** (V1.1 #2) **
1237 e30a a7 00              [ 4 ]         staa   0,x                 Width is 1 byte. Store it from IX8-15.
1238 e30c 20 0f              [ 3 ]         bra    nqend               Then go to wrap up routine.
1239 e30e ed 00              [ 5 ] nq2     std    0,x                 For Width of 2 bytes, store from IX0-15.
1240 e310 20 0b              [ 3 ]         bra    nqend
1241 e312 18 e6 00           [ 5 ] nqloop  ldab   0,y                 For Width > 2 bytes, move a byte from the
1242 e315 e7 00              [ 4 ]         stab   0,x                   source address to the destination address.
1243 e317 08                 [ 3 ]         inx
1244 e318 18 08              [ 4 ]         iny
1245 e31a 4a                 [ 2 ]         deca                       Decrement the counter in ACCA.
1246 e31b 26 f5              [ 3 ]         bne   nqloop               Loop until done.
1247 e31d 38                 [ 5 ] nqend   pulx                       When all done, get the address of the queue
1248 e31e e6 02              [ 4 ]         ldab  QSEMA,x                header, and test for a waiter on queue
1249                               *                                    Not Empty.
1250 e320 26 87              [ 3 ]         bne   postem               If there is a waiting task, go resume it.
1251 e322 7e e1 27           [ 3 ] nopost  jmp   endtsk               If not, just go back to caller.
1252 e325 c6 01              [ 2 ] full    ldab  #1                   If queue is full, set up a wait on it.
1253                               *                                  Queue Not Full semaphore = Not Empty + 1.
1254 e327 20 86              [ 3 ]         bra   qempty               Go set up the Wait condition.
1255                               
1256                               *******************************************************************************
1257                               *                                                                             *
1258                               * Resume a task. This is the opposite function of .suspnd.. The SUSPEND state *
1259                               * is removed from the specified task. If the removal of the suspension makes  *
1260                               * the task runnable, it is scheduled. If it is of higher priority than the    *
1261                               * resuming task, a context switch will occur. Note that the task to be        *
1262                               * resumed must be explicitly specified by the content of ACCA. A task may not *
1263                               * resume itself, obviously.                                                   *
1264                               *                                                                             *
1265                               * calling sequence:                                                           *
1266                               *                                                                             *
1267                               *                   ACCA = task number                                        *
1268                               *                   swi                                                       *
1269                               *                    FCB   .resume.                                                 *
1270                               *                   return:  All registers unchanged                          *
1271                               *                                                                             *
1272                               *******************************************************************************
1273                               
1274 e329 86 7f              [ 2 ] .resume ldaa   #-_SUSPND-1
1275 e32b 7e e1 0d           [ 3 ]         jmp    clrstat             Go clear the task's suspend status.
1276                               
1277                               *******************************************************************************
1278                               *                                                                             *
1279                               * Suspend a task. This function is used to set a task into the SUSPEND state. *
1280                               * Once in this state, it cannot be made runnable again except by a .resume.   *
1281                               * ESR or an .execute. ESR. The task to be suspended is specified by putting   *
1282                               * its task number in ACCA. If the current task is suspendeing itself, ACCA    *
1283                               * is set to either the task number, if known, or more simply, a 0.            *
1284                               *                                                                             *
1285                               * calling sequence:                                                           *
1286                               *                                                                             *
1287                               *                   ACCA = task number (Otherwise this must be 0)             *
1288                               *                   swi                                                       *
1289                               *                    FCB   .suspend.                                                 *
1290                               *                   return:  All registers unchanged                          *
1291                               *                                                                             *
1292                               *******************************************************************************
1293 e32e 5d                 [ 2 ] .suspnd tstb
1294 e32f 26 04              [ 3 ]         bne    notcur              See if the task to suspend is SELF.
1295 e331 de f5              [ 4 ]         ldx    curtcb              It is. Load TCB address.
1296 e333 20 07              [ 3 ]         bra    setspnd
1297 e335 86 05              [ 2 ] notcur  ldaa   #TCBLEN             If not current task, compute TCB address
1298 e337 3d                 [10 ]         mul                          of the specified task.
1299 e338 c3 00 9c           [ 4 ]         addd   #STATLS-TCBLEN
1300 e33b 8f                 [ 3 ]         xgdx
1301 e33c 1c 00 80           [ 7 ] setspnd bset   STATE,x _SUSPND     Set the SUSPEND state in task's status byte.
1302 e33f 7e e1 27           [ 3 ]         jmp    endtsk
1303                               
1304                               *******************************************************************************
1305                               *                                                                             *
1306                               * Terminate a task. This is a seldom used task but is included for complete-  *
1307                               * ness. This function is called when it is desireable to terminate a task. It *
1308                               * may be any task in the system including the caller. If the caller is going  *
1309                               * to commit suicide, the given task number is set to 0. As a result of this   *
1310                               * ESR, all timers which are in process for the terminated task are purged     *
1311                               * the active timer list. The terminated task is set to an IDLE state. Once    *
1312                               * terminated, a task may be restarted only by the .xeqt. command.             *
1313                               *                                                                             *
1314                               * calling sequence:                                                           *
1315                               *                                                                             *
1316                               *                   ACCA = Task number (0 if self)                            *
1317                               *                   swi                                                       *
1318                               *                    FCB  .terminate.                                                 *
1319                               *                   return only if not terminating self. Registers unchanged  *
1320                               *                                                                             *
1321                               *******************************************************************************
1322                               
1323 e342 5d                 [ 2 ] .termn8 tstb                       Test for self.
1324 e343 26 08              [ 3 ]         bne    selfnot             Branch if task to terminate is not self.
1325 e345 d6 f4              [ 3 ]         ldab   curtsk              If self, get current task number.
1326 e347 de f5              [ 4 ]         ldx    curtcb              Then set up current task's TCB address.
1327 e349 d7 fc              [ 3 ]         stab   temp+1              Store in lower half of temp
1328 e34b 20 09              [ 3 ]         bra    setidle             Then go set up the IDLE state.
1329 e34d d7 fc              [ 3 ] selfnot stab   temp+1              Store task # in lower half of temp.
1330 e34f 86 05              [ 2 ]         ldaa   #TCBLEN
1331 e351 3d                 [10 ]         mul                        Compute TCB address of task to be terminated
1332 e352 c3 00 9c           [ 4 ]         addd   #STATLS-TCBLEN
1333 e355 8f                 [ 3 ]         xgdx
1334 e356 1c 00 01           [ 7 ] setidle bset   STATE,x _IDLE       Set task's state to IDLE
1335 e359 4f                 [ 2 ]         clra
1336 e35a 7e e4 36           [ 3 ]         jmp    beginp              Then go purge all the task's timers.
1337                               
1338                               
1339                               *******************************************************************************
1340                               *                                                                             *
1341                               * Execute a task. This function is used to put a task into the state of being *
1342                               * ready to run. Its TCB is initialized so that its stack pointer is set to    *
1343                               * the base address assigned to it. A stack frame is allocated on the task's   *
1344                               * stack for an initial context. That context is set to contain the task's     *
1345                               * starting address as the PC, while CCR, ACCB, and ACCA are cleared.          *
1346                               *                                                                             *
1347                               * calling sequence:                                                           *
1348                               *                                                                             *
1349                               *                   ACCA = task number (cannot be SELF)                       *
1350                               *                   swi                                                       *
1351                               *                    FCB   .execute.                                                   *
1352                               *                   return:  All registers unchanged                          *
1353                               *                                                                             *
1354                               *******************************************************************************
1355                               
1356 e35d 37                 [ 3 ] .xeqt   pshb                       Save the task number
1357 e35e 86 07              [ 2 ]         ldaa   #TCBDATL            Load length of TCB init data block
1358 e360 3d                 [10 ]         mul                        Multiply it by task number.
1359 e361 c3 e0 05           [ 4 ]         addd   #TCBDATA-TCBDATL
1360 e364 8f                 [ 3 ]         xgdx
1361 e365 ec 03              [ 5 ]         ldd    RSTSP,x             Get the base address of task's stack space.
1362 e367 83 00 09           [ 4 ]         subd   #9
1363 e36a 18 8f              [ 4 ]         xgdy
1364 e36c ec 01              [ 5 ]         ldd    STRTADR,x           Set up PC to be the starting address
1365 e36e ee 05              [ 5 ]         ldx    TCBADDR,x
1366 e370 18 ed 08           [ 6 ]         std    PC+1,y
1367 e373 4f                 [ 2 ]         clra
1368 e374 5f                 [ 2 ]         clrb
1369 e375 18 a7 01           [ 5 ]         staa   CCR+1,y             Clear CCR
1370 e378 18 ed 02           [ 6 ]         std    ACCB+1,y            Clear ACCB and ACCA
1371 e37b 18 8f              [ 4 ]         xgdy                       Put address of stack context back into D
1372 e37d ed 01              [ 5 ]         std    ACTSP,x             Store address of the context in the TCB.
1373 e37f 4f                 [ 2 ]         clra
1374 e380 7e e1 17           [ 3 ]         jmp    clrbits             Go make the task runnable.
1375                               
1376                               *******************************************************************************
1377                               *                                                                             *
1378                               * Delay a task for a period of time. This function uses the .timer. ESR       *
1379                               * to set up a timer and a wait state on the specified task.  When the timer   *
1380                               * elapses, the specified task is resumed.                                     *
1381                               *                                                                             *
1382                               * calling sequence:                                                           *
1383                               *                                                                             *
1384                               *                   ACCA = Task number (0 if self)                            *
1385                               *                   ACCB = Semaphore number (0 if task's semaphore)           *
1386                               *                   IX = Number of clock tocks to delay                       *
1387                               *                   swi                                                       *
1388                               *                    FCB   .delay.                                                  *
1389                               *                   return. Registers unchanged                               *
1390                               *                                                                             *
1391                               *******************************************************************************
1392                               
1393 e383 86 ff              [ 2 ] .delay  ldaa   #$FF                Set up switch.
1394                               
1395                               *******************************************************************************
1396                               *                                                                             *
1397                               * Set up a timer for a task. This function is used to set a timer active for  *
1398                               * the specified task. The timer is in clock tock units. A clock tock is a     *
1399                               * system defined parameter. The timers are 16-bit timers; therefore, the      *
1400                               * maximum duration of a timer is determined by the clock tock frequency.      *
1401                               *                                                                             *
1402                               * calling sequence:                                                           *
1403                               *                                                                             *
1404                               *                   ACCA = Task number (0 if self)                            *
1405                               *                   ACCB = Semaphore number (0 if task's semaphore)           *
1406                               *                   IX = Number of clock tocks in timer                       *
1407                               *                   swi                                                       *
1408                               *                    FCB   .timer.                                                  *
1409                               *                   return. Registers unchanged                               *
1410                               *                           ACCA will be current task number if ACCA was = 0  *
1411                               *                             at the time of the ESR.                         *
1412                               *                                                                             *
1413                               *******************************************************************************
1414                               
1415 e385 4c                 [ 2 ] .timer  inca                       Set up switch: 0 = .delay., >0 = .timer.
1416 e386 36                 [ 3 ]         psha                       Save the switch.
1417 e387 5d                 [ 2 ]         tstb                       Test for task being self.
1418 e388 26 09              [ 3 ]         bne    notself             branch if task # is not 0.
1419 e38a de f5              [ 4 ]         ldx    curtcb              Get address of current task's TCB
1420 e38c 96 f4              [ 3 ]         ldaa   curtsk              get the current task number.
1421 e38e 18 a7 02           [ 5 ]         staa   ACCA,y              Save it in the stack context.
1422 e391 20 07              [ 3 ]         bra    gotask
1423 e393 86 05              [ 2 ] notself ldaa   #TCBLEN
1424 e395 3d                 [10 ]         mul                        Compute TCB address of specified task.
1425 e396 c3 00 9c           [ 4 ]         addd   #STATLS-TCBLEN
1426 e399 8f                 [ 3 ]         xgdx
1427 e39a 18 e6 02           [ 5 ] gotask  ldab   ACCA,y              Get the actual task number
1428 e39d 37                 [ 3 ]         pshb                       Save the task number.
1429 e39e 3c                 [ 4 ]         pshx                       Save the TCB address of the specified task.
1430 e39f 18 a6 01           [ 5 ]         ldaa   ACCB,y              Get the semaphore number to use with timer.
1431 e3a2 26 05              [ 3 ]         bne    gotsema             Branch if semaphore number is defined.
1432 e3a4 18 a6 02           [ 5 ]         ldaa   ACCA,y              If semaphore # = 0, Use task semaphore of
1433 e3a7 8b 08              [ 2 ]         adda   #NNAMSEM
1434 e3a9 36                 [ 3 ] gotsema psha                         specified task. Save semaphore number.
1435 e3aa 18 ec 03           [ 6 ]         ldd    IX,y                Get the timer value.
1436 e3ad 2b 02              [ 3 ]         bmi    savrset             If timer < 0, go save the timer reset value.
1437 e3af 4f                 [ 2 ]         clra
1438 e3b0 5f                 [ 2 ]         clrb                       Timer is a one-shot. Reset time = 0.
1439 e3b1 37                 [ 3 ] savrset pshb                       Save the reset time.
1440 e3b2 36                 [ 3 ]         psha
1441 e3b3 18 ec 03           [ 6 ]         ldd    IX,y                Get the timer (as specified) again.
1442 e3b6 2a 05              [ 3 ]         bpl    savtime             See if it is cyclic or one-shot.
1443 e3b8 43                 [ 2 ]         coma                       If cyclic, be sure it is positive.
1444 e3b9 50                 [ 2 ]         negb
1445 e3ba 25 01              [ 3 ]         bcs    savtime
1446 e3bc 4c                 [ 2 ]         inca
1447 e3bd ce 00 f2           [ 3 ] savtime ldx    #ACTIVE             Let IX contain the address of the active
1448 e3c0 0f                 [ 2 ]         sei                          timers.
1449 e3c1 1a ee 00           [ 6 ] tloop   ldy    CLINK,x             Get address of next timer.
1450 e3c4 27 1b              [ 3 ]         beq    append              If end-of-list, go append new timer.
1451 e3c6 cd a3 02           [ 7 ]         cpd    CTOCKS,y            There is a timer that is active. Compare its
1452                               *                                    timer counts with those in the new timer.
1453 e3c9 2d 07              [ 3 ]         blt    nsrtm               If there are fewer tocks in the new timer,
1454                               *                                    go insert the new timer in front of the
1455                               *                                    active one.
1456 e3cb 18 a3 02           [ 7 ]         subd   CTOCKS,y            If not, subtract the tocks of the active
1457                               *                                    timer from the new timer.
1458 e3ce ee 00              [ 5 ]         ldx    CLINK,x             Then move down the thread.
1459 e3d0 20 ef              [ 3 ]         bra    tloop
1460 e3d2 37                 [ 3 ] nsrtm   pshb                       Save the remaining time in the timer.
1461 e3d3 36                 [ 3 ]         psha
1462 e3d4 18 a3 02           [ 7 ]         subd   CTOCKS,y            Update the active timer in the list
1463 e3d7 43                 [ 2 ]         coma                         subtracting the new timer's residual
1464 e3d8 50                 [ 2 ]         negb                         from it.
1465 e3d9 25 01              [ 3 ]         bcs    updt
1466 e3db 4c                 [ 2 ]         inca
1467 e3dc 18 ed 02           [ 6 ] updt    std    CTOCKS,y            Store the updated timer.
1468 e3df 20 02              [ 3 ]         bra    linkit
1469 e3e1 37                 [ 3 ] append  pshb                       Save the timer.
1470 e3e2 36                 [ 3 ]         psha
1471 e3e3 ec 00              [ 5 ] linkit  ldd    CLINK,x             Get the address of the current active timer.
1472 e3e5 37                 [ 3 ]         pshb
1473 e3e6 36                 [ 3 ]         psha                       Save the address
1474 e3e7 dc f0              [ 4 ]         ldd    FREE                Get the address of the next free timer block
1475 e3e9 ed 00              [ 5 ]         std    CLINK,x             Store it in link of the active timer block.
1476 e3eb 18 8f              [ 4 ]         xgdy                       IY now contains address of the new timer blk
1477 e3ed 18 ec 00           [ 6 ]         ldd    CLINK,y             Get address of next free timer block.
1478 e3f0 dd f0              [ 4 ]         std    FREE                Save it in pointer.
1479 e3f2 32                 [ 4 ]         pula
1480 e3f3 33                 [ 4 ]         pulb                       Get address of the current active timer.
1481 e3f4 18 ed 00           [ 6 ]         std    CLINK,y             Store it in link word of the new timer block
1482 e3f7 32                 [ 4 ]         pula
1483 e3f8 33                 [ 4 ]         pulb
1484 e3f9 18 ed 02           [ 6 ]         std    CTOCKS,y            Store timer tocks in new timer block.
1485 e3fc 32                 [ 4 ]         pula
1486 e3fd 33                 [ 4 ]         pulb
1487 e3fe 18 ed 04           [ 6 ]         std    CRESET,y            Store timer reset value.
1488 e401 33                 [ 4 ]         pulb
1489 e402 18 e7 07           [ 5 ]         stab   CSEMA,y             Store semaphore #
1490 e405 38                 [ 5 ]         pulx                       Get TCB address
1491 e406 32                 [ 4 ]         pula
1492 e407 18 a7 06           [ 5 ]         staa   CTASK,y             Store # of the task using the timer.
1493 e40a 32                 [ 4 ]         pula                       Get the switch
1494 e40b 4d                 [ 2 ]         tsta
1495 e40c 27 03              [ 3 ]         beq    dlay                Branch if switch set for .delay.
1496 e40e 7e e1 aa           [ 3 ]         jmp    dopend              ** (V1.1 #3) **
1497 e411 1c 00 40           [ 7 ] dlay    bset   STATE,x _WAIT       If .delay., set wait state in task.
1498 e414 ce 00 be           [ 3 ]         ldx    #FLGTBL-1
1499 e417 3a                 [ 3 ]         abx                        Compute address of semaphore.
1500 e418 18 a6 06           [ 5 ]         ldaa   CTASK,y             Get the # of the task being delayed.
1501 e41b 40                 [ 2 ]         nega
1502 e41c a7 00              [ 4 ]         staa   0,x                 Set the semaphore to WAIT state.
1503 e41e 7e e1 27           [ 3 ]         jmp    endtsk
1504                               
1505                               *******************************************************************************
1506                               *                                                                             *
1507                               * Purge a timer or timers. This function is used to purge one timer for a     *
1508                               * given task and semaphore combination or all of the timers for a given task. *
1509                               * Each timer so purged has its associated semaphore reset to the PENDing      *
1510                               * state.                                                                      *
1511                               *                                                                             *
1512                               * calling sequence:                                                           *
1513                               *                                                                             *
1514                               *                   ACCA = Task number (0 if self)                            *
1515                               *                   ACCB = Semaphore number (0 if task's semaphore)           *
1516                               *                   IX0-7= Switch: 0 = purge all timers for given task        *
1517                               *                                  >0 = purge timer matching task and sema    *
1518                               *                   swi                                                       *
1519                               *                    FCB   .purge.                                                  *
1520                               *                   return. Registers unchanged                               *
1521                               *                                                                             *
1522                               *******************************************************************************
1523                               
1524 e421 5d                 [ 2 ] .purge  tstb
1525 e422 26 02              [ 3 ]         bne    gotsk               If ACCB > 0, task is specific.
1526 e424 d6 f4              [ 3 ]         ldab   curtsk              Otherwise, use current task.
1527 e426 dd fb              [ 4 ] gotsk   std    temp                Save task and semaphore numbers.
1528 e428 4f                 [ 2 ] chksema clra
1529 e429 18 6d 04           [ 7 ]         tst    IXL,y               Test the switch for type of purge.
1530 e42c 27 08              [ 3 ]         beq    beginp              Branch if switch = 0.
1531 e42e 96 fb              [ 3 ]         ldaa   temp                Otherwise get the semaphore number to match.
1532 e430 26 04              [ 3 ]         bne    beginp              Branch if it is defined.
1533 e432 96 fc              [ 3 ]         ldaa   temp+1              Otherwise use the task semaphore.
1534 e434 8b 08              [ 2 ]         adda   #NNAMSEM
1535 e436 d6 fc              [ 3 ] beginp  ldab   temp+1              Load the task number to be matched.
1536 e438 ce 00 f2           [ 3 ]         ldx    #ACTIVE             Set up pointer to 1st active timer.
1537 e43b 0f                 [ 2 ]         sei                        Interrupts off during this next phase.
1538 e43c 1a ee 00           [ 6 ] ploop   ldy    CLINK,x             Set IY = address of next active timer.
1539 e43f 27 45              [ 3 ]         beq    endpurg             If end-of-list, purge is complete.
1540 e441 18 e1 06           [ 5 ]         cmpb   CTASK,y             Compare task # in active timer to object #.
1541 e444 27 04              [ 3 ]         beq    sametsk             Branch if both task numbers are equal.
1542 e446 ee 00              [ 5 ] chknxt  ldx    CLINK,x             If not equal, walk list to next active timer
1543 e448 20 f2              [ 3 ]         bra    ploop               Keep looking.
1544 e44a 4d                 [ 2 ] sametsk tsta                       Tasks are equal. Test if semaphore # = 0.
1545 e44b 27 05              [ 3 ]         beq    remove              Branch if semaphore # = 0.
1546 e44d 18 a1 07           [ 5 ]         cmpa   CSEMA,y             If semaphore > 0, Check it against semaphore
1547 e450 26 f4              [ 3 ]         bne    chknxt                in active timer. Branch if not the same.
1548 e452 37                 [ 3 ] remove  pshb
1549 e453 36                 [ 3 ]         psha                       Save semaphore and task number.
1550 e454 3c                 [ 4 ]         pshx                       Save IX for a moment.
1551 e455 ce 00 be           [ 3 ]         ldx    #FLGTBL-1
1552 e458 18 e6 07           [ 5 ]         ldab   CSEMA,y
1553 e45b 3a                 [ 3 ]         abx                        Compute address of timer's semaphore.
1554 e45c 86 01              [ 2 ]         ldaa   #_PEND
1555 e45e a7 00              [ 4 ]         staa   0,x                 Set timer's semaphore back to PENDing.
1556 e460 38                 [ 5 ]         pulx                       Restore IX
1557 e461 18 ec 00           [ 6 ]         ldd    CLINK,y             Get the pointer to next active timer block.
1558 e464 ed 00              [ 5 ]         std    CLINK,x             Store it in link word of pointer to current
1559                               *                                    active timer.
1560                               *** (V1.4 #3) *** |
1561 e466 27 10              [ 3 ]         beq    prgexit                                                      |
1562 e468 18 ec 02           [ 6 ]         ldd    CTOCKS,y            Update the next timer in link            |
1563                               *** (V1.5 #1) *** +
1564 e46b 18 3c              [ 5 ]         pshy                       Save y                                 +
1565 e46d 18 ee 00           [ 6 ]         ldy    CLINK,y                                                      |
1566 e470 18 e3 02           [ 7 ]         addd   CTOCKS,y                                                     |
1567 e473 18 ed 02           [ 6 ]         std    CTOCKS,y                                                     |
1568 e476 18 38              [ 6 ]         puly                       Restore Y                              +
1569 e478 dc f0              [ 4 ] prgexit ldd    FREE                                                         |
1570 e47a 18 ed 00           [ 6 ]         std    CLINK,y             Make current timer block the first free one.
1571 e47d 18 8f              [ 4 ]         xgdy
1572 e47f dd f0              [ 4 ]         std    FREE
1573 e481 32                 [ 4 ]         pula
1574 e482 33                 [ 4 ]         pulb                       Restore task and semaphore numbers.
1575 e483 4d                 [ 2 ]         tsta                       Test the semaphore number.
1576 e484 27 b6              [ 3 ]         beq    ploop               Branch if semaphore = 0. (purge all timers)
1577 e486 7e e1 27           [ 3 ] endpurg jmp    endtsk              Otherwise that's all.
1578                               *CLKDRIVR.AS
1579                               *******************************************************************************
1580                               *                                                                             *
1581                               *  MCX11 Clock Driver task and Interrupt Service Routine (ISR) for the RTI    *
1582                               *  timer of the HC11 chip.                                                    *
1583                               *                                                                             *
1584                               * This task should be assembled with the source of MCX11 as it is considered  *
1585                               * a system task and does not need to clutter up the application code.         *
1586                               *                                                                             *
1587                               *                         --- N O T I C E ---                                 *
1588                               *                                                                             *
1589                               * This code assumes that the clock driver is task 1. If your assignment is    *
1590                               * different, be sure you make the necessary changes in this module or things  *
1591                               * are not going to work.                                                      *
1592                               *                                                                             *
1593                               *******************************************************************************
1594                               
1595 0001                          CLKTASK equ     1                   Clock driver is normally task # 1.
1596                               
1597 e489 5f                 [ 2 ] clkdrv  clrb                        Use task semaphore for synchronization.
1598 e48a 3f                 [14 ]         swi
1599 e48b 01                                FCB   .wait.               Wait for a timer to expire.
1600 e48c de f2              [ 4 ] tmrdone ldx    ACTIVE               Get the address of the first active timer.
1601 e48e 27 f9              [ 3 ]         beq    clkdrv               Make sure there is one.
1602 e490 ec 02              [ 5 ]         ldd    CTOCKS,x             If timer exists, check TOCK count to see
1603                               *                                     if it has expired. (count <= 0)
1604 e492 2e f5              [ 3 ]         bgt    clkdrv               If TOCK count > 0, timer hasn't expired.
1605 e494 ec 00              [ 5 ]         ldd    CLINK,x              Timer has expired. Unlink it from active
1606 e496 dd f2              [ 4 ]         std    ACTIVE                timer thread. (ACTIVE <== (NEXT))
1607 e498 dc f0              [ 4 ]         ldd    FREE                 Then put it into the unused timer thread.
1608 e49a ed 00              [ 5 ]         std    CLINK,x                (NEXT <== (FREE), FREE <== (CURRENT))
1609 e49c df f0              [ 4 ]         stx    FREE
1610 e49e ec 06              [ 5 ]         ldd    CTASK,x              Get waiting task and semaphore numbers.
1611                               *** (V1.4) ***
1612 e4a0 3f                 [14 ]         swi                                                                    |
1613 e4a1 02                                FCB   .signal.             In either case, signal the waiting task    |
1614                               *                                     that timer has expired.
1615                               
1616 e4a2 ee 04              [ 5 ]         ldx    CRESET,x             Also get the Cyclic Timer Reset counts.
1617 e4a4 2a e6              [ 3 ]         bpl    tmrdone              If reset counter >= 0, timer is a one-shot.|
1618 e4a6 3f                 [14 ]         swi
1619 e4a7 0e                                FCB   .timer.              Otherwise, time is cyclic and needs to be
1620                               *                                     reinserted into the timer thread.
1621 e4a8 20 e2              [ 3 ]         bra    tmrdone              Then go see if another timer expired too.
1622                               
1623                               *******************************************************************************
1624                               *                                                                             *
1625                               *                      RTI Interrupt Service Routine                          *
1626                               *                                                                             *
1627                               *******************************************************************************
1628                               
1629 e4aa 86 40              [ 2 ] rtiisr  ldaa   #RTIF                Reset the interrupt flag
1630 e4ac b7 10 25           [ 4 ]         staa   TFLG2
1631 e4af 7a 00 ef           [ 6 ]         dec    tickcnt              Decrement TICK count to see if TOCK
1632 e4b2 27 01              [ 3 ]         beq    tockdon
1633 e4b4 3b                 [12 ] rtixit  rti                         If not a TOCK, exit quickly.
1634 e4b5 86 03              [ 2 ] tockdon ldaa   #TOCK                For a TOCK, reset the TICK count.
1635 e4b7 97 ef              [ 3 ]         staa   tickcnt
1636 e4b9 de f2              [ 4 ]         ldx    ACTIVE               See if there is an active timer.
1637 e4bb 27 f7              [ 3 ]         beq    rtixit               If not, return immediately.
1638 e4bd ec 02              [ 5 ]         ldd    CTOCKS,x             Decrement the TOCK count
1639 e4bf 83 00 01           [ 4 ]         subd   #1                   If timer didn't expire, quick exit.
1640 e4c2 ed 02              [ 5 ]         std    CTOCKS,x
1641 e4c4 26 ee              [ 3 ]         bne    rtixit
1642 e4c6 7d 00 fa           [ 6 ]         tst    intlvl               Here we have an expired timer. Test the
1643 e4c9 26 0c              [ 3 ]         bne    cnotl1                 interrupt nest level. branch if not lvl 1
1644 e4cb 7d 00 f4           [ 6 ]         tst    curtsk               If level 1, test if Dispatcher was
1645 e4ce 27 07              [ 3 ]         beq    cnotl1                 interrupted. If so, treat as system.
1646 e4d0 de f5              [ 4 ]         ldx    curtcb               If a task was interrupted, get its TCB
1647 e4d2 af 01              [ 5 ]         sts    ACTSP,x                address and save the stack pointer.
1648 e4d4 8e 00 1f           [ 3 ]         lds    #SYSTACK             Set up system stack pointer.
1649 e4d7 7c 00 fa           [ 6 ] cnotl1  inc    intlvl               Bump interrupt nest level.
1650 e4da 0e                 [ 2 ]         cli                         Enable interrupts.
1651 e4db c6 09              [ 2 ]         ldab   #NNAMSEM+CLKTASK     Set up task semaphore # for clock driver.
1652 e4dd 7e e0 f3           [ 3 ]         jmp    isrrtn               Do a context switch to clock driver.
1653                               
